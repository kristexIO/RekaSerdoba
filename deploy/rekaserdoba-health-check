set -euo pipefail

config=/etc/rekaserdoba/server.json
deadline=$((SECONDS + 30))
until systemctl is-active --quiet rekaserdoba.service rekaserdoba-net-helper.service caddy.service &&
    curl --fail --silent --show-error --max-time 5 http://127.0.0.1:9080/readyz >/dev/null; do
    test "$SECONDS" -lt "$deadline"
    sleep 1
done
certificate=$(jq -er '.h3.certificate_pem' "$config")
openssl x509 -checkend 604800 -noout -in "$certificate"
