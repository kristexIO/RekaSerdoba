[Unit]
Description=RekaSerdoba laboratory protocol edge
After=network-online.target rekaserdoba-net-helper.service
Wants=network-online.target rekaserdoba-net-helper.service
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=rekaserdoba
Group=rekaserdoba
ExecStartPre=/opt/rekaserdoba/bin/rekaserdoba-server --check-config /etc/rekaserdoba/server.json
ExecStart=/opt/rekaserdoba/bin/rekaserdoba-server /etc/rekaserdoba/server.json
Restart=always
RestartSec=3s
TimeoutStopSec=20s
Environment=RUST_LOG=rekaserdoba_server=info
LimitNOFILE=65536
TasksMax=256
MemoryMax=512M

NoNewPrivileges=true
PrivateDevices=false
PrivateTmp=true
ProtectClock=true
ProtectControlGroups=true
ProtectHome=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectProc=invisible
ProtectSystem=strict
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
SystemCallArchitectures=native
UMask=0077
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_BIND_SERVICE
LockPersonality=true
MemoryDenyWriteExecute=true

[Install]
WantedBy=multi-user.target
